[Unit]
Description=CTF ServiceDesk instance %i
After=network-online.target
Wants=network-online.target

[Service]
User=free-lab-web
Group=free-lab-web
WorkingDirectory=/opt/idor-free-lab/services/%i
ExecStart=/usr/bin/python3 /opt/idor-free-lab/services/%i/portal.py --config /etc/idor-free-lab/%i.json --host 0.0.0.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/idor-free-lab/%i
UMask=0077

[Install]
WantedBy=multi-user.target
