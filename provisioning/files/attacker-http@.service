[Unit]
Description=IDOR lab HTTP identity page for %i
After=network-online.target
Wants=network-online.target

[Service]
User=attacker-http
Group=attacker-http
WorkingDirectory=/opt/idor-free-lab
ExecStart=/usr/bin/python3 /opt/idor-free-lab/attacker_http.py --node %i --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
